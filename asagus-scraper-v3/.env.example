APP_NAME=ASAGUS Scraper 3.0
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
OPERATOR_TOKEN=

POSTGRES_URL=postgresql://asagus:asagus@localhost:5432/asagus
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_HOST=http://localhost:9200
QDRANT_HOST=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=asagus-graph
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=asagus-access
MINIO_SECRET_KEY=asagus-secret
MINIO_BUCKET=asagus-raw-html

ENABLE_NETWORK_FETCH=true
ENABLE_SEARCH_DISCOVERY=true
ENABLE_INFRA_PERSISTENCE=false

# Dynamic browser automation engine for JavaScript rendering.
# Options: playwright, patchright, camoufox, nodriver, auto
BROWSER_AUTOMATION_ENGINE=playwright
BROWSER_HEADLESS=true
CAMOUFOX_BINARY_PATH=

# Optional saved-login browser sessions for authorized Facebook/Instagram runs.
# Defaults to data/social_auth_sessions/<session_label>/<platform>.storage_state.json when blank.
SOCIAL_AUTH_SESSIONS_DIR=
FACEBOOK_STORAGE_STATE_PATH=
INSTAGRAM_STORAGE_STATE_PATH=

LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
DEEPINFRA_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
PERPLEXITY_API_KEY=

RESIDENTIAL_PROXY_URL=
ISP_STATIC_PROXY_URL=
DATACENTER_PROXY_URL=
BUDGET_RESIDENTIAL_PROXY_URL=
GOOGLE_GEOCODING_API_KEY=
